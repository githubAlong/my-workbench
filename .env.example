# 服务端口（发布平台会自动注入 PORT）
PORT=3000
HOST=0.0.0.0

# 演示模式：1 = 验证码直接回显到页面、任意手机号可登录（仅本地试用）
# 上线必须设为 0，否则任何人都能进你的工作台
DEMO_MODE=0
DEV_OTP_ECHO=0

# ---------- 短信通道（三种任选其一，都不填则只能用密码登录）----------
SMS_SIGN_NAME=我的工作台
SMS_TEMPLATE_CODE=

# 方式一：通用 webhook（收到 POST JSON: {phone, code, template, text}）
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# 方式二：阿里云短信
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# 方式三：腾讯云短信
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_REGION=ap-guangzhou

# ---------- 微信 / QQ 扫码登录（不填则扫码入口显示为未开通）----------
WX_APPID=
WX_APPSECRET=

QQ_APPID=
QQ_APPKEY=

# ---------- WorkBuddy 统一登录（OAuth 2.1 授权码流程）----------
# 1. 去 https://open.workbuddy.cn 注册开发者账号，创建应用
# 2. 在应用里登记「OAuth 回调地址」：https://你的域名/api/auth/workbuddy/callback
# 3. 把 client id / secret 填到这里
# 4. 勾选授权范围 user.profile.readable（用于取昵称头像）
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
# 必须写完整 https 地址，且与应用里登记的一字不差（结尾斜杠也要一致）
WORKBUDDY_REDIRECT_URI=

# ---------- 部署协议 ----------
# 部署在 https 反向代理后面时置 1：会话 Cookie 带 Secure、回调协议推断用 https
PROD_HTTPS=0

# ---------- 可选：数据与上传目录 ----------
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# ===== 绝对不能提交 =====
# .env 里有测试通行证、短信密钥等敏感配置，只提交 .env.example
.env
.env.local
.env.*.local

# 数据库：里面有真实用户、真实上课记录，属于个人数据
data/
*.db
*.db-shm
*.db-wal

# 用户上传的文件（课件、图片）
uploads/

# 备份快照
backups/

# 依赖
node_modules/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 开发过程截图（体积大，保留在本地即可）
screenshots/
preview/shots/

# 打包产物（由 tools/build_bundle.py 生成，部署时现构建）
dist/
.tmp_student_entry.js
